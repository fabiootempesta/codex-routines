{
  "name": "codex-routines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local control room for scheduled Codex CLI routines. Author Markdown prompts, pick a schedule, run as a small daemon — see live runs, history, and recovery in a dark IDE-style UI.",
  "license": "MIT",
  "author": "Fabio Tempesta",
  "homepage": "https://github.com/fabiootempesta/codex-routines#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabiootempesta/codex-routines.git"
  },
  "bugs": {
    "url": "https://github.com/fabiootempesta/codex-routines/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "automation",
    "scheduler",
    "cron",
    "agent",
    "ai",
    "llm",
    "developer-tools",
    "cli",
    "daemon",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "daemon:start": "node scripts/daemon.mjs start",
    "daemon:stop": "node scripts/daemon.mjs stop",
    "daemon:status": "node scripts/daemon.mjs status"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "croner": "^9.1.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.59.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "5.4.21",
    "vitest": "^2.1.8"
  }
}
